{
  "name": "charmlight-dice",
  "version": "0.1.0",
  "description": "3D dice for Charmlight: three.js rendering, cannon-es physics, backend-supplied results",
  "author": {
    "name": "Frank Ali"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "3D",
    "dice",
    "roll",
    "roller",
    "javascript",
    "rpg",
    "dnd",
    "d&d",
    "tabletop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anatoly108/charmlight-dice"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "charmlight-dice-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "public",
    "bin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser/*.test.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "cannon-es-debugger": "^1.0.0",
    "playwright": "1.65.0",
    "vite": "^3.0.8"
  }
}
